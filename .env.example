# Holy Crap Simulation Lab — local environment.
# Copy to .env and adjust as needed. The values below are safe local-development
# defaults. Never put secrets, tokens, or keys in this file or in .env.

# Root directory for mutable lab state (models and runs).
# Defaults to the repository-local .simlab directory when unset.
HOLY_CRAP_HOME=.simlab

# Interface for the API server (`python -m holy_crap_simlab.cli serve`).
HOLY_CRAP_API_HOST=127.0.0.1
HOLY_CRAP_API_PORT=8000

# Maximum accepted whole-pen video upload size in bytes (default: 1 GiB).
# HOLY_CRAP_MAX_VIDEO_BYTES=1073741824

# --- Optional integration settings (safe to leave commented out) ---

# --- QNX target execution ---
# Probe runs are target-validation only (evaluation_kind=target_probe):
# they prove that one exact model artifact and one canonical scenario JSON
# reached the physical Pi and were processed there. The highest capability
# status QNX can report is probe_only; it never reports ready until actual
# inference exists on the Pi. Clip assessment is separately fail-closed: it
# requires worker mode plus a reviewed deployment manifest from the target.

# QNX_EXECUTOR_MODE=disabled|probe|worker
# disabled = no Pi contact; probe = transport validation only; worker = allow
# clip jobs after the physical target's deployment manifest passes hash checks.
QNX_EXECUTOR_MODE=disabled
# SSH alias for the headless Pi (see TARGET.md for the connection procedure).
QNX_SSH_ALIAS=qnxpi
# Optional HostName override when the alias needs a fixed address.
# QNX_SSH_HOSTNAME=192.168.4.248
# ConnectTimeout seconds for each ssh/scp call.
QNX_SSH_TIMEOUT=20
# Local timeout (seconds) for a single ssh/scp subprocess call.
QNX_COMMAND_TIMEOUT=300
# Optional persistent-runner helper override. The checked-in helper is used by
# default and forwards QNX_SSH_HOSTNAME through every ssh/scp call.
# QNX_SUBMIT_JOB=/absolute/path/to/a/compatible/qnx-submit-job.py
# Remote run directory and Python interpreter on the Pi.
QNX_REMOTE_ROOT=/data/home/qnxuser/simlab-runs
QNX_REMOTE_PYTHON=/system/bin/python3
# Persistent runner application directory and spool on the Pi.
QNX_RUNNER_APP_DIR=/data/home/qnxuser/qnx-runner-app
QNX_RUNNER_SPOOL=/data/home/qnxuser/qnx-runner
# Per-job and job-wait timeouts for the persistent runner helper.
QNX_JOB_TIMEOUT=300
QNX_WAIT_TIMEOUT=600
# Override the committed target/qnx/simlab_probe.py worker (testing only).
# QNX_WORKER_PATH=target/qnx/simlab_probe.py

# Full clip-assessment worker contract. All three values are required in worker
# mode. The manifest must contain schema_version=1,
# contract="holy-crap.clip-assessment.v1", platform="QNX", worker_path, and the
# installed worker's SHA-256. The host verifies the manifest hash; the QNX
# wrapper verifies the installed worker hash before executing it. Until these
# are physically deployed and reviewed, QNX clip jobs end as blocked and never
# fall back to local inference.
# QNX_CLIP_WORKER_REMOTE=/data/home/qnxuser/holy-crap/clip-worker.py
# QNX_CLIP_WORKER_MANIFEST=/data/home/qnxuser/holy-crap/deployment.json
# QNX_CLIP_WORKER_MANIFEST_SHA256=<64 lowercase hex characters>
# Override target/qnx/clip_assessment_worker.py (testing only).
# QNX_CLIP_WRAPPER_PATH=target/qnx/clip_assessment_worker.py
# --- QNX edge runtime observability (read-only) ---
# The lab API reads the edge pipeline's loopback status endpoint through SSH
# using the target Python interpreter. Both URLs must stay on 127.0.0.1 or
# localhost; the runner refuses anything else, and no shell ever interpolates
# them. Runtime status polling is read-only and never triggers fault tests.
# QNX_EDGE_STATUS_URL=http://127.0.0.1:8088/telemetry
# QNX_EDGE_CRASH_URL=http://127.0.0.1:8088/crash
# Target-side timeout (seconds) for one edge status or fault-test request.
QNX_EDGE_STATUS_TIMEOUT=10
# Guarded fault-test switch. Only "1" enables POST
# /api/v1/system/qnx/fault-tests/{process}, which is allowlisted to the edge's
# supervised infer/model/cloud/site processes and fails closed otherwise.
# Safe default: off.
QNX_EDGE_FAULT_TESTS=0

# The QNX edge itself has a second, independent gate. Set this in the target
# process environment only for an attended containment test. Both this gate and
# QNX_EDGE_FAULT_TESTS above must be enabled; each defaults off.
HC_EDGE_FAULT_TESTS=0
# The edge status/fault HTTP listener defaults to loopback. An operator may
# explicitly override it for a controlled network setup; prefer SSH + loopback.
# HC_EDGE_BIND=127.0.0.1

# The dev supervisor enables this automatically. Set it when starting the API directly.
HOLY_CRAP_FARMER_ALERTS_ENABLED=1
HOLY_CRAP_FARMER_AGENT_URL=http://127.0.0.1:4317/simulation-alerts
HOLY_CRAP_ALERT_PEN_NAME=Pen 6
