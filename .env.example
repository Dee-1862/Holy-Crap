# Holy Crap Simulation Lab — local environment.
# Copy to .env and adjust as needed. The values below are safe local-development
# defaults. Never put secrets, tokens, or keys in this file or in .env.

# Root directory for mutable lab state (models and runs).
# Defaults to the repository-local .simlab directory when unset.
HOLY_CRAP_HOME=.simlab

# Interface for the API server (`python -m holy_crap_simlab.cli serve`).
HOLY_CRAP_API_HOST=127.0.0.1
HOLY_CRAP_API_PORT=8000

# --- Optional integration settings (safe to leave commented out) ---

# SSH alias for the physical QNX Pi. Used only by manual integration steps;
# setup scripts and CI never touch the Pi.
# QNX_SSH_ALIAS=qnxpi
