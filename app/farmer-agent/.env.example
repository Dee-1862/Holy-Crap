# Holy-Crap farmer messaging agent
# Copy to .env.local or load these values from your secret manager.
# Never commit real keys or phone numbers.

# Safe default. Live mode is opt-in.
MESSAGING_MODE=mock
MESSAGING_STATE_PATH=.data/messaging-state.json
MESSAGING_POLL_MS=10000
MESSAGING_TIMEOUT_MS=10000

# Farmers the agent is allowed to message and answer.
FARMER_ALLOWED_NUMBERS=+15555550123

# Optional veterinarian conversation. The farmer must clearly agree before it starts.
# The default must also be in VET_ALLOWED_NUMBERS.
# Replace this placeholder only after the teammate or veterinarian verifies the number.
VET_ALLOWED_NUMBERS=+15555550199
DEFAULT_VET_NUMBER=+15555550199

# Photon 2.0 Beta. The agent number is the SMS number provisioned in Photon.
PHOTON_PROJECT_ID=pho_prj_REPLACE_ME
PHOTON_API_KEY=replace-with-project-key
PHOTON_AGENT_PHONE=+15555550188
PHOTON_BASE_URL=https://api.photon.codes/v1

# DeepSeek's OpenAI-compatible Chat Completions endpoint.
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MAX_TOKENS=180

# Voice is a disabled scaffold until a provider is implemented.
# VOICE_PROVIDER=retell
# VOICE_PROVIDER_URL=https://provider.example.invalid
# VOICE_PROVIDER_TOKEN=replace-me
