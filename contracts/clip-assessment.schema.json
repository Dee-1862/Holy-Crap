{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holy-crap.local/contracts/clip-assessment.schema.json",
  "title": "Holy Crap whole-pen clip assessment",
  "description": "One non-diagnostic aggregate assessment of a complete whole-pen video.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "created_at", "video", "modules", "summary", "non_diagnostic_notice"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^clip-[a-f0-9-]{36}$"},
    "status": {"enum": ["completed", "failed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes", "media_type", "duration_s", "width", "height", "fps", "source", "demo_asset_id", "catalog_clip_id", "bytes_available", "content_url", "metadata_source", "metadata_warnings"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "pattern": "^video/"},
        "duration_s": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "width": {"type": ["integer", "null"], "minimum": 1},
        "height": {"type": ["integer", "null"], "minimum": 1},
        "fps": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "source": {"enum": ["upload", "demo", "catalog_mock"]},
        "demo_asset_id": {"type": ["string", "null"]},
        "catalog_clip_id": {"type": ["string", "null"]},
        "bytes_available": {"type": "boolean"},
        "content_url": {"type": ["string", "null"], "pattern": "^/api/v1/clip-assessments/"},
        "metadata_source": {"enum": ["ffprobe", "demo_manifest", "catalog", "unavailable"]},
        "metadata_warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "modules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "mode", "version", "status", "adapter", "input_contract", "output_contract", "artifact", "notice"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "mode": {"enum": ["mock", "real"]},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["completed", "not_configured", "failed"]},
          "adapter": {"type": "string", "minLength": 1},
          "input_contract": {"type": "object"},
          "output_contract": {"type": "object"},
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required_for_real_mode", "status", "model_id", "expected_formats", "compatibility_verified"],
            "properties": {
              "required_for_real_mode": {"type": "boolean"},
              "status": {"enum": ["not_configured", "configured"]},
              "model_id": {"type": ["string", "null"]},
              "expected_formats": {"type": "array", "items": {"type": "string"}},
              "compatibility_verified": {"type": "boolean"}
            }
          },
          "notice": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity", "appearance", "feces", "overall"],
      "properties": {
        "activity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "category", "motion_coverage", "zone_scores"],
          "properties": {
            "score": {"type": "number", "minimum": 0, "maximum": 1},
            "category": {"enum": ["low", "typical", "high"]},
            "motion_coverage": {"type": "number", "minimum": 0, "maximum": 1},
            "zone_scores": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}
          }
        },
        "appearance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "category", "notes"],
          "properties": {
            "score": {"type": "number", "minimum": 0, "maximum": 1},
            "category": {"enum": ["review", "mixed", "typical-looking"]},
            "notes": {"type": "array", "items": {"type": "string"}}
          }
        },
        "feces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_count", "class_distribution", "candidates"],
          "properties": {
            "candidate_count": {"type": "integer", "minimum": 0},
            "class_distribution": {
              "type": "object",
              "additionalProperties": false,
              "required": ["Coccidiosis", "Healthy", "New Castle Disease", "Salmonella"],
              "properties": {
                "Coccidiosis": {"type": "integer", "minimum": 0},
                "Healthy": {"type": "integer", "minimum": 0},
                "New Castle Disease": {"type": "integer", "minimum": 0},
                "Salmonella": {"type": "integer", "minimum": 0}
              }
            },
            "candidates": {
              "type": "array",
              "items": {"$ref": "#/$defs/fecesCandidate"}
            }
          }
        },
        "overall": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_state", "notes"],
          "properties": {
            "review_state": {"const": "synthetic-demo-only"},
            "notes": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "non_diagnostic_notice": {"type": "string", "pattern": "SYNTHETIC MOCK OUTPUT"}
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "fecesCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timestamp_s", "bbox", "detection_confidence", "crop", "classification"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "timestamp_s": {"type": "number", "minimum": 0},
        "bbox": {"$ref": "#/$defs/bbox"},
        "detection_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_video_sha256", "timestamp_s", "bbox", "color_space", "target_width", "target_height", "materialized"],
          "properties": {
            "source_video_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "timestamp_s": {"type": "number", "minimum": 0},
            "bbox": {"$ref": "#/$defs/bbox"},
            "color_space": {"const": "RGB"},
            "target_width": {"const": 224},
            "target_height": {"const": 224},
            "materialized": {"type": "boolean"}
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "confidence", "mode"],
          "properties": {
            "label": {"enum": ["Coccidiosis", "Healthy", "New Castle Disease", "Salmonella"]},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "mode": {"enum": ["mock", "real"]}
          }
        }
      }
    }
  }
}
