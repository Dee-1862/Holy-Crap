{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holy-crap.local/contracts/dataset-clip.schema.json",
  "title": "Holy Crap reviewed dataset clip",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "dataset_name", "status", "review_verdict", "camera_fit", "best_use", "limitations", "source_url", "dataset_url", "license", "doi", "media_kind", "media_type", "filename", "duration_s", "width", "height", "fps", "expected_size_bytes", "byte_range_start", "byte_range_end", "demo_asset_id", "assessable", "bytes_available", "content_url"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "dataset_name": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "cataloged", "reference_only", "rejected"]},
    "review_verdict": {"type": "string", "minLength": 1},
    "camera_fit": {"type": "string", "minLength": 1},
    "best_use": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_url": {"type": "string", "format": "uri"},
    "dataset_url": {"type": "string", "format": "uri"},
    "license": {"type": "string", "minLength": 1},
    "doi": {"type": ["string", "null"]},
    "media_kind": {"enum": ["video", "images"]},
    "media_type": {"type": ["string", "null"]},
    "filename": {"type": ["string", "null"]},
    "duration_s": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "width": {"type": ["integer", "null"], "minimum": 1},
    "height": {"type": ["integer", "null"], "minimum": 1},
    "fps": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "expected_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "byte_range_start": {"type": ["integer", "null"], "minimum": 0},
    "byte_range_end": {"type": ["integer", "null"], "minimum": 0},
    "demo_asset_id": {"type": ["string", "null"]},
    "assessable": {"type": "boolean"},
    "bytes_available": {"type": "boolean"},
    "content_url": {"type": ["string", "null"]},
    "installed_size_bytes": {"type": ["integer", "null"], "minimum": 0}
  }
}
