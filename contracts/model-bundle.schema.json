{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holy-crap.local/contracts/model-bundle.schema.json",
  "title": "Holy Crap model bundle",
  "description": "Metadata for an immutable model artifact registered with the simulation lab.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "model_file",
    "sha256",
    "format",
    "input",
    "output",
    "labels",
    "provenance",
    "metrics",
    "compatibility",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "model_file": {
      "type": "string",
      "minLength": 1,
      "description": "Path relative to the bundle root. Absolute paths and parent traversal are invalid."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "format": {
      "enum": ["tflite", "onnx"]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "channels", "dtype", "layout", "color_space", "normalization"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 1, "maximum": 4},
        "dtype": {"enum": ["uint8", "int8", "float16", "float32"]},
        "layout": {"enum": ["NHWC", "NCHW"]},
        "color_space": {"enum": ["RGB", "BGR", "GRAY"]},
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["none", "scale_offset", "mean_std"]},
            "scale": {
              "oneOf": [
                {"type": "number"},
                {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 4}
              ]
            },
            "offset": {
              "oneOf": [
                {"type": "number"},
                {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 4}
              ]
            },
            "mean": {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 4},
            "std": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 1, "maxItems": 4}
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "dtype", "interpretation"],
      "properties": {
        "task": {"enum": ["classification", "detection", "segmentation", "embedding", "anomaly_score"]},
        "dtype": {"enum": ["uint8", "int8", "float16", "float32"]},
        "interpretation": {"type": "string", "minLength": 1},
        "threshold": {"type": "number"},
        "shape": {"type": "array", "items": {"type": "integer"}, "minItems": 1}
      }
    },
    "labels": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "training_run"],
      "properties": {
        "producer": {"type": "string", "minLength": 1},
        "training_run": {"type": "string", "minLength": 1},
        "dataset_revision": {"type": ["string", "null"]},
        "source_commit": {"type": ["string", "null"]},
        "export_tool": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "metrics": {
      "type": "object",
      "description": "Training or held-out metrics reported by the producer. Simulation metrics belong in run results.",
      "additionalProperties": {"type": "number"}
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimes", "quantization"],
      "properties": {
        "runtimes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "platform": {"type": ["string", "null"]},
              "verified": {"type": "boolean", "default": false}
            }
          }
        },
        "quantization": {"enum": ["none", "float16", "dynamic", "int8", "uint8"]},
        "required_operators": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "notes": {"type": ["string", "null"]}
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
